# =============================================================================
# REQ//PAINEL · Variáveis de Configuração de Ambiente
# Copie este arquivo para .env no mesmo diretório para customizar localmente.
# =============================================================================

# Banco de Dados MySQL / MariaDB Local
PAINEL_DB_HOST=127.0.0.1
PAINEL_DB_PORT=3306
PAINEL_DB_USER=root
PAINEL_DB_PASSWORD=
PAINEL_DB_NAME=painel_requisicoes

# Segurança e Sessão Flask
# Se deixado em branco, uma chave segura aleatória é criada em storage/.painel_secret
PAINEL_SECRET_KEY=
PAINEL_COOKIE_SECURE=false

# Integração GitHub REST API (Opcional)
# Um token de leitura pessoal (fine-grained ou clássico sem escopos) eleva
# o rate limit da API pública de 60 requisições/hora para 5.000 requisições/hora.
GITHUB_TOKEN=

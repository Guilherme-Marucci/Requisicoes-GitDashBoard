# Configuração privada desta aplicação. Variáveis do processo têm prioridade.
# Copie para .env apenas quando ele não existir; nunca publique credenciais.
REQUISICOES_STORAGE_DIR=storage
REQUISICOES_MAX_AGE_SECONDS=900

# SEGURANÇA E AUTENTICAÇÃO FLASK:
AUTH_SECRET_KEY=
FLASK_SECRET_KEY=
# Identificação do perfil dedicado ao Painel TV na tabela usuarios:
TV_LOGIN_EMAIL=projetos@ssonic.com.br
TV_LOGIN_NAME=TVREQ

# CONFIGURAÇÃO DO BANCO DE DADOS MYSQL (sistema_login / tabela usuarios):
# Suporta tanto os nomes MYSQL_* quanto os aliases legados DB_*:
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=sistema_login
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=5
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=5
MYSQL_RETRY_ATTEMPTS=3
MYSQL_RETRY_BACKOFF_SECONDS=0.5

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_NAME=sistema_login

# CONFIGURAÇÃO DE ENVIO DE E-MAIL (SMTP transacional — ativação de conta e recuperação de senha):
# MAIL_ENABLED=false = modo desenvolvimento: nada é enviado e o link com o token é registrado no console.
# Destinatários são restritos a @ssonic.com.br. O timeout de rede é fixo em 10 segundos (não configurável).
MAIL_ENABLED=false
MAIL_HOST=
# 587 = STARTTLS (MAIL_USE_TLS=true); 465 = SSL/TLS nativo (MAIL_USE_SSL=true, assumido automaticamente na 465).
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Conta de serviço. A senha fica somente no .env privado; credenciais exigem TLS ou SSL.
MAIL_USERNAME=automacao@ssonic.com.br
MAIL_PASSWORD=
MAIL_SENDER=automacao@ssonic.com.br
MAIL_SENDER_NAME=Painel de Requisições Supersonic
# Base dos links enviados: {APP_BASE_URL}/auth/verificar?token=... e {APP_BASE_URL}/login?reset_token=...
APP_BASE_URL=http://localhost:5000

# CONFIGURAÇÃO DO BANCO DE DADOS SQL SERVER (coletor independente ERP):
# Servidor\\instancia ou host,porta, conforme o ambiente homologado.
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_RD_PASSWORD=
DB_DRIVER=ODBC Driver 13 for SQL Server

# Habilite após configurar a conta SELECT. CODREQ é a chave; revise os demais campos em core/erp.py.
# Coleta: python sincronizar.py --fonte erp; não há mais fonte demonstrativa.
SQLSERVER_ENABLED=false
# sql: DB_USERNAME/DB_RD_PASSWORD; windows: identidade do processo coletor.
SQLSERVER_AUTH=sql
SQLSERVER_CONNECT_TIMEOUT=10
SQLSERVER_QUERY_TIMEOUT=30
SQLSERVER_MAX_ROWS=10000
# Criptografia e certificado TLS do SQL Server (yes/no):
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=no

# NOVO PAINEL (MySQL local + RBAC + GitHub) — ver README-PAINEL.md
PAINEL_DB_HOST=127.0.0.1
PAINEL_DB_PORT=3306
PAINEL_DB_USER=root
PAINEL_DB_PASSWORD=
PAINEL_DB_NAME=painel_requisicoes
PAINEL_SECRET_KEY=
PAINEL_COOKIE_SECURE=false
# Opcional: token GitHub (somente leitura/público) para elevar o rate limit
GITHUB_TOKEN=
